+
+/* GastoClaro personal menu and monthly plan */
+.topbar-user-button {
+    border: 0;
+    background: transparent;
+    display: inline-flex;
+    align-items: center;
+    gap: 10px;
+    padding: 4px 6px 4px 10px;
+    border-radius: 999px;
+    color: #1f2937;
+}
+
+.topbar-user-button:hover,
+.topbar-user-button:focus {
+    background: #f3f5f9;
+    outline: none;
+}
+
+.topbar-user-name {
+    max-width: 160px;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+
+.topbar-personal-menu {
+    min-width: 235px;
+    border-radius: 14px;
+    overflow: hidden;
+}
+
+.gasto-claro-page .nav-pills .nav-link {
+    border-radius: 999px;
+}
+
+.gasto-month-hero {
+    background: linear-gradient(135deg, #0f172a, #1d4ed8);
+    color: #ffffff;
+    border-radius: 20px;
+    padding: 22px 24px;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 1rem;
+    box-shadow: 0 16px 35px rgba(15, 23, 42, 0.18);
+}
+
+.gasto-hero-number {
+    background: rgba(255, 255, 255, 0.12);
+    border: 1px solid rgba(255, 255, 255, 0.14);
+    border-radius: 18px;
+    padding: 14px 18px;
+    min-width: 220px;
+    text-align: right;
+    font-size: 1.45rem;
+    font-weight: 800;
+}
+
+.gasto-excel-card {
+    background: #ffffff;
+    border-radius: 16px;
+    border: 1px solid #d7e0eb;
+    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.07);
+    overflow: hidden;
+}
+
+.gasto-excel-title {
+    background: #0f172a;
+    color: #ffffff;
+    font-weight: 800;
+    text-align: center;
+    padding: 8px 12px;
+    letter-spacing: 0.02em;
+}
+
+.gasto-excel-table thead th {
+    background: #3f7fdc;
+    color: #ffffff;
+    font-size: 0.78rem;
+    white-space: nowrap;
+    border-color: #2f68bc;
+}
+
+.gasto-excel-table td,
+.gasto-excel-table th {
+    border-color: #c8d4e2;
+    vertical-align: middle;
+}
+
+.gasto-total-row td {
+    background: #d7e8f8;
+    font-weight: 800;
+    border-top: 2px solid #94a3b8;
+}
+
+@media (max-width: 768px) {
+    .topbar-date {
+        display: none;
+    }
+
+    .topbar {
+        justify-content: flex-end !important;
+        padding: 0 14px;
+    }
+
+    .topbar-user-name {
+        display: none;
+    }
+
+    .gasto-month-hero {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .gasto-hero-number {
+        min-width: 0;
+        text-align: left;
+    }
+}
