+    private LocalDate dateFromDueDay(YearMonth yearMonth, Integer dueDay) {
+        if (dueDay == null) {
+            return null;
+        }
+        int safeDay = Math.max(1, Math.min(yearMonth.lengthOfMonth(), dueDay));
+        return yearMonth.atDay(safeDay);
+    }
