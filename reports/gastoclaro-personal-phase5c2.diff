+<!DOCTYPE html>
+<html lang="es" xmlns:th="http://www.thymeleaf.org">
+<head th:replace="fragments/head_admin :: adminHead('GastoClaro - Abono voluntario')"></head>
+<body>
+<div class="app-layout" th:with="activePage='gasto_claro_debts'">
+  <aside th:replace="fragments/sidebar :: sidebar"></aside>
+  <div class="main-content">
+    <header th:replace="fragments/topbar :: topbar"></header>
+    <main class="content-wrapper gasto-claro-page">
+      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
+        <div>
+          <h1 class="h4 mb-1">Crear abono voluntario</h1>
+          <p class="text-muted mb-0">Agrega al plan mensual solo el monto que realmente decidiste pagar. Esto no reactiva el cronograma antiguo.</p>
+        </div>
+        <a th:href="@{/gasto-claro/debts}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Volver a deudas</a>
+      </div>
+
+      <div th:replace="personal_finance/_nav :: nav('debts')"></div>
