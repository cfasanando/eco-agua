+
+      <div class="row g-3">
+        <div class="col-lg-5">
+          <div class="card border-0 shadow-sm h-100">
+            <div class="card-header bg-white fw-semibold">Deuda en seguimiento</div>
+            <div class="card-body">
+              <h2 class="h5" th:text="${debt.name}">Deuda</h2>
+              <div class="text-muted mb-3" th:text="${debt.creditorName != null and !#strings.isEmpty(debt.creditorName) ? debt.creditorName : debt.debtType.label}">Acreedor</div>
+              <dl class="row small mb-0">
+                <dt class="col-6">Saldo pendiente</dt>
+                <dd class="col-6 text-end"><span th:text="${debt.currency}">PEN</span> <span th:text="${#numbers.formatDecimal(debt.currentBalance,1,'POINT',2,'POINT')}">0.00</span></dd>
+                <dt class="col-6">Estado</dt>
+                <dd class="col-6 text-end" th:text="${debt.status.label}">En mora</dd>
+                <dt class="col-6">Días aproximados</dt>
+                <dd class="col-6 text-end" th:text="${debt.delinquencyStartDate != null ? debt.overdueDays() : '-'}">-</dd>
+                <dt class="col-6">Cobranza</dt>
+                <dd class="col-6 text-end" th:text="${debt.collectionStatus.label}">Sin gestión</dd>
+                <dt class="col-6">Negociación</dt>
+                <dd class="col-6 text-end" th:text="${debt.negotiationStatus.label}">Sin iniciar</dd>
+              </dl>
+              <div class="alert alert-warning small mt-3 mb-0">El abono aparecerá como obligación del mes elegido. El saldo total de la deuda no se reducirá automáticamente hasta implementar el registro real de pagos en 5D.</div>
+            </div>
+          </div>
+        </div>
+
+        <div class="col-lg-7">
+          <div class="card border-0 shadow-sm">
+            <div class="card-header bg-white fw-semibold">Datos del abono</div>
+            <div class="card-body">
+              <form th:action="@{/gasto-claro/debts/{id}/voluntary-payment(id=${debt.id})}" method="post" th:object="${paymentForm}" class="row g-3">
+                <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}"/>
+                <div class="col-md-6">
+                  <label class="form-label">Monto decidido</label>
+                  <input type="number" step="0.01" min="0.01" class="form-control" th:field="*{amount}" required>
+                </div>
+                <div class="col-md-6">
+                  <label class="form-label">Moneda</label>
+                  <select class="form-select" th:field="*{currency}">
+                    <option th:each="currency : ${currencies}" th:value="${currency}" th:text="${currency}">PEN</option>
+                  </select>
+                </div>
+                <div class="col-md-6">
+                  <label class="form-label">Fecha prevista</label>
+                  <input type="date" class="form-control" th:field="*{dueDate}" required>
+                </div>
+                <div class="col-md-6">
+                  <label class="form-label">Prioridad</label>
+                  <select class="form-select" th:field="*{priority}">
+                    <option th:each="priority : ${priorities}" th:value="${priority}" th:text="${priority.label}">Media</option>
+                  </select>
+                </div>
+                <div class="col-12">
+                  <label class="form-label">Motivo u observación</label>
+                  <textarea class="form-control" rows="3" th:field="*{notes}" placeholder="Ej. Abono para iniciar negociación, oferta de liquidación o pago acordado."></textarea>
+                </div>
+                <div class="col-12 d-grid gap-2 d-md-flex justify-content-md-end">
+                  <a th:href="@{/gasto-claro/debts}" class="btn btn-outline-secondary">Cancelar</a>
+                  <button type="submit" class="btn btn-warning"><i class="bi bi-cash-coin"></i> Agregar al plan mensual</button>
+                </div>
+              </form>
+            </div>
+          </div>
+        </div>
+      </div>
+    </main>
+  </div>
+</div>
+<div th:replace="fragments/scripts_admin :: scripts"></div>
+</body>
+</html>
