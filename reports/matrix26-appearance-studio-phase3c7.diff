+                        <article><div></div><small>Popular</small><strong>Customer favorite</strong><span>S/ 32.00</span><button type="button">View</button></article>
+                        <article><div></div><small>New</small><strong>Seasonal option</strong><span>S/ 15.00</span><button type="button">View</button></article>
+                    </div>
+                </div>
