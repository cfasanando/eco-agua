+                <article><span><i class="bi bi-x-octagon"></i></span><div><strong th:text="${summary.failed}">0</strong><small>Failed</small></div></article>
+                <article><span><i class="bi bi-hdd"></i></span><div><strong th:text="${T(com.ecoamazonas.eco_agua.platform.control.backups.Matrix26BackupService).formatBytes(summary.totalBytes)}">0 B</strong><small>Stored database dumps</small></div></article>
+            </section>
+
+            <div class="row g-4 mb-4">
