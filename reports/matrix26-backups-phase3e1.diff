+        verify(job.id(), "GZIP_READABLE", "Readable GZIP archive", inspection.readable(), inspection.message());
+        verify(job.id(), "DATABASE_OWNERSHIP", "Database ownership marker", inspection.databaseMarker(),
+                inspection.databaseMarker()
