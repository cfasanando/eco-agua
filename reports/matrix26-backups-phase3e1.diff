+<!DOCTYPE html>
+<html lang="es" xmlns:th="http://www.thymeleaf.org">
+<head th:replace="~{control_center/fragments/head :: head('New database backup')}"></head>
+<body class="matrix26-body">
+<div class="matrix26-shell">
+    <aside th:replace="~{control_center/fragments/sidebar :: sidebar(${activePage})}"></aside>
+    <div class="matrix26-content">
+        <header th:replace="~{control_center/fragments/topbar :: topbar('New database backup', 'Create a verified export of an isolated laboratory database.')}"></header>
+        <main class="matrix26-main">
+            <div th:if="${backupError}" class="alert alert-danger" th:text="${backupError}"></div>
+            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4">
+                <div><span class="matrix26-eyebrow">Manual backup</span><h1 class="matrix26-page-title">Select an eligible instance</h1></div>
+                <a class="btn btn-outline-secondary" th:href="@{/control-center/backups}"><i class="bi bi-arrow-left me-1"></i>Back</a>
+            </div>
+
+            <div class="alert alert-info">
+                This phase exports only the selected database. Runtime files, uploads, logos, and branding assets will be added in Phase 3E.2.
+            </div>
+            <div th:unless="${tool.available}" class="alert alert-danger">
+                <strong>Backup tool unavailable.</strong>
+                <span th:text="${tool.message}">Tool message</span>
+            </div>
+
+            <form th:action="@{/control-center/backups}" method="post" class="matrix26-panel matrix26-backup-form">
+                <input type="hidden" th:name="${_csrf.parameterName}" th:value="${_csrf.token}">
+                <div class="matrix26-panel-header"><div><span>Target</span><h2>Database backup request</h2></div></div>
+
+                <div class="matrix26-backup-candidates">
+                    <label th:each="candidate : ${candidates}" class="matrix26-backup-candidate" th:classappend="${candidate.allowed} ? ' is-enabled' : ' is-disabled'">
+                        <input type="radio" name="instanceId" th:value="${candidate.instanceId}"
+                               th:checked="${selectedInstanceId != null and selectedInstanceId == candidate.instanceId}"
+                               th:disabled="${!candidate.allowed}" required>
+                        <span class="matrix26-backup-candidate-icon"><i class="bi bi-building"></i></span>
+                        <span class="matrix26-backup-candidate-copy">
+                            <strong th:text="${candidate.businessName}">Instance</strong>
+                            <small><code th:text="${candidate.instanceCode}">code</code> · <code th:text="${candidate.databaseName}">database</code></small>
+                            <small th:if="${candidate.allowed}" class="text-success">Eligible for Phase 3E.1</small>
+                            <small th:unless="${candidate.allowed}" class="text-danger" th:text="${candidate.restrictionReason}">Blocked</small>
+                        </span>
+                    </label>
+                </div>
+
+                <div class="matrix26-backup-plan mt-4">
+                    <h3>Verification plan</h3>
+                    <ul>
+                        <li><i class="bi bi-check2"></i> Validate Matrix26 registration and runtime database</li>
+                        <li><i class="bi bi-check2"></i> Check table count and free storage</li>
+                        <li><i class="bi bi-check2"></i> Export with a transaction-consistent database dump</li>
+                        <li><i class="bi bi-check2"></i> Compress with GZIP</li>
+                        <li><i class="bi bi-check2"></i> Inspect SQL structure and ownership marker</li>
+                        <li><i class="bi bi-check2"></i> Calculate and recheck SHA-256</li>
+                        <li><i class="bi bi-check2"></i> Generate manifest and report</li>
+                    </ul>
+                </div>
+
+                <dl class="matrix26-settings-list mt-4">
+                    <div><dt>Backup root</dt><dd><code class="matrix26-code-wrap" th:text="${backupRoot}">path</code></dd></div>
+                    <div><dt>Tool</dt><dd th:text="${tool.available ? tool.version : 'Unavailable'}">Tool</dd></div>
+                </dl>
+
+                <label class="matrix26-confirmation mt-4">
+                    <input type="checkbox" name="confirmation" value="true" required>
+                    <span>I confirm that Matrix26 may create a manual database backup for the selected laboratory instance.</span>
+                </label>
+
+                <div class="d-flex justify-content-end gap-2 mt-4">
+                    <a class="btn btn-outline-secondary" th:href="@{/control-center/backups}">Cancel</a>
+                    <button class="btn btn-primary" type="submit" th:disabled="${!tool.available}">
+                        <i class="bi bi-shield-check me-1"></i>Create and verify backup
+                    </button>
+                </div>
+            </form>
+        </main>
+    </div>
+</div>
+<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
+</body>
+</html>
