+                        </div>
+                        <div th:unless="${tool.available}" class="alert alert-warning small mb-0 mt-3">
+                            Configure <code>MATRIX26_MYSQLDUMP_PATH</code> with the full path to <code>mysqldump.exe</code> or <code>mariadb-dump.exe</code>.
+                        </div>
+                    </section>
+                </div>
+            </div>
+
+            <section class="matrix26-panel">
+                <div class="matrix26-panel-header">
