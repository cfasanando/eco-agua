+                            <td><strong th:text="${item.instanceName}">Instance</strong><small><code th:text="${item.instanceCode}">code</code></small></td>
+                            <td th:text="${item.scheduleLabel()}">Daily</td>
+                            <td th:text="${item.nextRunAt != null ? #temporals.format(item.nextRunAt, 'dd/MM/yyyy HH:mm') : 'Disabled'}">Date</td>
+                            <td><span class="badge text-bg-secondary" th:text="${item.lastStatus != null ? item.lastStatus : 'Never'}">Never</span></td>
+                            <td><span class="badge" th:classappend="${item.enabled} ? ' text-bg-success' : ' text-bg-secondary'" th:text="${item.enabled ? 'Enabled' : 'Disabled'}">State</span></td>
