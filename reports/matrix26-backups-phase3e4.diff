+<!DOCTYPE html>
+<html lang="en" xmlns:th="http://www.thymeleaf.org">
+<head th:replace="~{control_center/fragments/head :: head('Backup calendar')}"></head>
+<body class="matrix26-body">
+<div class="matrix26-shell">
+    <aside th:replace="~{control_center/fragments/sidebar :: sidebar(${activePage})}"></aside>
+    <div class="matrix26-content">
+        <header th:replace="~{control_center/fragments/topbar :: topbar('Backup calendar', 'Planned and completed automatic recovery points.')}"></header>
+        <main class="matrix26-main">
+            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
+                <div>
+                    <span class="matrix26-eyebrow">Scheduler calendar</span>
+                    <h1 class="matrix26-page-title">Next <span th:text="${days}">31</span> days</h1>
+                    <p class="matrix26-page-subtitle mb-0">Timezone: <strong th:text="${timezone}">America/Lima</strong></p>
+                </div>
+                <div class="d-flex gap-2">
+                    <a class="btn btn-outline-secondary" th:href="@{/control-center/backups/schedules}"><i class="bi bi-arrow-left me-1"></i>Schedules</a>
+                    <a class="btn btn-outline-primary" th:href="@{/control-center/backups/calendar(days=90)}">90 days</a>
+                </div>
+            </div>
+
+            <section class="matrix26-panel">
+                <div th:if="${#lists.isEmpty(events)}" class="matrix26-empty-state">
+                    <i class="bi bi-calendar3"></i><strong>No calendar events</strong><span>Create and enable a backup schedule.</span>
+                </div>
+                <div th:unless="${#lists.isEmpty(events)}" class="matrix26-backup-timeline">
+                    <article th:each="event : ${events}" class="matrix26-backup-timeline-item">
+                        <time>
+                            <strong th:text="${#temporals.format(event.scheduledAt, 'dd MMM')}">25 Jun</strong>
+                            <span th:text="${#temporals.format(event.scheduledAt, 'HH:mm')}">02:00</span>
+                        </time>
+                        <div>
+                            <div class="d-flex align-items-center gap-2 flex-wrap">
+                                <strong th:text="${event.scheduleName}">Schedule</strong>
+                                <span class="badge" th:classappend="${event.badgeClass}" th:text="${event.status}">Planned</span>
+                            </div>
+                            <small th:text="${event.instanceName + ' · ' + event.instanceCode + ' · ' + event.eventType}">Instance</small>
+                        </div>
+                        <a th:if="${event.backupJobId != null}" class="btn btn-sm btn-outline-primary" th:href="@{/control-center/backups/{id}(id=${event.backupJobId})}" title="View backup"><i class="bi bi-eye"></i></a>
+                    </article>
+                </div>
+            </section>
+        </main>
+    </div>
+</div>
+<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
+</body>
+</html>
