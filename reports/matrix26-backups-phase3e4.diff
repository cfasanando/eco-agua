+<!DOCTYPE html>
+<html lang="en" xmlns:th="http://www.thymeleaf.org">
+<head th:replace="~{control_center/fragments/head :: head('Backup schedule')}"></head>
+<body class="matrix26-body">
+<div class="matrix26-shell">
+    <aside th:replace="~{control_center/fragments/sidebar :: sidebar(${activePage})}"></aside>
+    <div class="matrix26-content">
+        <header th:replace="~{control_center/fragments/topbar :: topbar('Backup schedule', 'Configure encrypted automatic recovery points.')}"></header>
+        <main class="matrix26-main">
+            <div th:if="${backupError}" class="alert alert-danger" th:text="${backupError}"></div>
+            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
+                <div>
+                    <span class="matrix26-eyebrow">Scheduler</span>
+                    <h1 class="matrix26-page-title" th:text="${schedule == null ? 'New backup schedule' : 'Edit backup schedule'}">Schedule</h1>
+                    <p class="matrix26-page-subtitle mb-0">All timestamps are evaluated in the selected IANA timezone.</p>
+                </div>
+                <a class="btn btn-outline-secondary" th:href="@{/control-center/backups/schedules}"><i class="bi bi-arrow-left me-1"></i>Back</a>
+            </div>
+
+            <form method="post" th:action="@{/control-center/backups/schedules}" class="matrix26-panel">
+                <input type="hidden" name="scheduleId" th:value="${schedule != null ? schedule.id : ''}">
+
+                <div class="matrix26-panel-header"><div><span>Target</span><h2>Instance and schedule identity</h2></div></div>
+                <div class="row g-3 mb-4">
+                    <div class="col-12 col-lg-7">
+                        <label class="form-label">Instance</label>
+                        <select class="form-select" name="instanceId" th:disabled="${schedule != null}" required>
+                            <option value="">Select an instance</option>
+                            <option th:each="candidate : ${candidates}"
+                                    th:if="${candidate.allowed}"
+                                    th:value="${candidate.instanceId}"
+                                    th:selected="${schedule != null ? schedule.instanceId == candidate.instanceId : selectedInstanceId == candidate.instanceId}"
+                                    th:text="${candidate.businessName + ' · ' + candidate.instanceCode}">
+                                Instance
+                            </option>
+                        </select>
+                        <input th:if="${schedule != null}" type="hidden" name="instanceId" th:value="${schedule.instanceId}">
+                    </div>
+                    <div class="col-12 col-lg-5">
+                        <label class="form-label">Schedule name</label>
+                        <input class="form-control" name="name" maxlength="160" required
+                               th:value="${schedule != null ? schedule.name : 'Daily encrypted backup'}">
+                    </div>
+                </div>
+
+                <div class="matrix26-panel-header"><div><span>Calendar</span><h2>Frequency and time</h2></div></div>
+                <div class="row g-3 mb-4">
