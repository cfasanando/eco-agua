+<!DOCTYPE html>
+<html lang="en" xmlns:th="http://www.thymeleaf.org">
+<head th:replace="~{control_center/fragments/head :: head('Backup executions')}"></head>
+<body class="matrix26-body">
+<div class="matrix26-shell">
+    <aside th:replace="~{control_center/fragments/sidebar :: sidebar(${activePage})}"></aside>
+    <div class="matrix26-content">
+        <header th:replace="~{control_center/fragments/topbar :: topbar('Backup executions', 'Scheduled runs, retries, missed windows, and results.')}"></header>
+        <main class="matrix26-main">
+            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
+                <div><span class="matrix26-eyebrow">Execution history</span><h1 class="matrix26-page-title">Automatic backup runs</h1></div>
+                <a class="btn btn-outline-secondary" th:href="@{/control-center/backups/schedules}"><i class="bi bi-arrow-left me-1"></i>Schedules</a>
+            </div>
+            <section class="matrix26-panel">
+                <div th:if="${#lists.isEmpty(executions)}" class="matrix26-empty-state">
+                    <i class="bi bi-list-check"></i><strong>No scheduled executions</strong><span>Automatic and manual schedule runs will appear here.</span>
+                </div>
+                <div th:unless="${#lists.isEmpty(executions)}" class="table-responsive">
+                    <table class="table align-middle mb-0 matrix26-table">
+                        <thead><tr><th>Planned</th><th>Schedule</th><th>Instance</th><th>Status</th><th>Attempts</th><th>Retry</th><th>Backup</th></tr></thead>
+                        <tbody>
+                        <tr th:each="execution : ${executions}">
+                            <td th:text="${#temporals.format(execution.plannedAt, 'dd/MM/yyyy HH:mm')}">Date</td>
+                            <td><strong th:text="${execution.scheduleName}">Schedule</strong><small><code th:text="${execution.triggerType}">Trigger</code></small></td>
+                            <td><strong th:text="${execution.instanceName}">Instance</strong><small th:text="${execution.instanceCode}">Code</small></td>
+                            <td><span class="badge" th:classappend="${execution.status.badgeClass}" th:text="${execution.status.label}">Status</span></td>
+                            <td th:text="${execution.attemptCount + ' / ' + execution.maxAttempts}">0 / 3</td>
+                            <td th:text="${execution.nextRetryAt != null ? #temporals.format(execution.nextRetryAt, 'dd/MM HH:mm') : '—'}">—</td>
+                            <td>
+                                <a th:if="${execution.backupJobId != null}" th:href="@{/control-center/backups/{id}(id=${execution.backupJobId})}" th:text="${execution.backupPublicId}">Backup</a>
+                                <span th:unless="${execution.backupJobId != null}">—</span>
+                            </td>
+                        </tr>
+                        </tbody>
+                    </table>
+                </div>
+            </section>
+        </main>
+    </div>
+</div>
+<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
+</body>
+</html>
