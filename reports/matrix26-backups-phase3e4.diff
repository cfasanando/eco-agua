+                <article><span><i class="bi bi-check2-circle"></i></span><div><strong th:text="${summary.completedExecutions}">0</strong><small>Completed runs</small></div></article>
+                <article><span><i class="bi bi-x-octagon"></i></span><div><strong th:text="${summary.failedExecutions}">0</strong><small>Failed runs</small></div></article>
+                <article><span><i class="bi bi-bell"></i></span><div><strong th:text="${summary.openAlerts}">0</strong><small>Open alerts</small></div></article>
+            </section>
+
+            <div class="row g-4 mb-4">
