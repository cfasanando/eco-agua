+                        <div class="matrix26-panel-header"><div><span>Database tooling</span><h2>Dump executable</h2></div></div>
+                        <div class="matrix26-backup-tool" th:classappend="${tool.available} ? ' is-ready' : ' is-blocked'">
+                            <span><i class="bi" th:classappend="${tool.available} ? ' bi-check2-circle' : ' bi-exclamation-triangle'"></i></span>
+                            <div>
+                                <strong th:text="${tool.available ? 'Ready' : 'Blocked'}">Status</strong>
+                                <small th:text="${tool.message}">Message</small>
+                                <code th:if="${tool.available}" th:text="${tool.executable}">Tool</code>
