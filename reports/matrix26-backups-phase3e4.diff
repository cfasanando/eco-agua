+                        <div class="matrix26-backup-tool" th:classappend="${keyStatus.available} ? ' is-ready' : ' is-blocked'">
+                            <span><i class="bi" th:classappend="${keyStatus.available} ? ' bi-shield-lock-fill' : ' bi-shield-exclamation'"></i></span>
+                            <div>
+                                <strong th:text="${keyStatus.available ? 'Ready' : 'Blocked'}">Status</strong>
