+                        </div>
+                    </section>
+                </div>
+            </div>
+
+            <section class="matrix26-panel">
+                <div class="matrix26-panel-header">
+                    <div><span>Policies</span><h2>Configured schedules</h2></div>
+                    <a th:href="@{/control-center/backups/alerts}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-bell me-1"></i>Alerts</a>
+                </div>
+                <div th:if="${#lists.isEmpty(schedules)}" class="matrix26-empty-state">
+                    <i class="bi bi-calendar2-plus"></i>
+                    <strong>No automatic backup schedules</strong>
+                    <span>Create the first encrypted schedule for the appearance laboratory.</span>
+                </div>
+                <div th:unless="${#lists.isEmpty(schedules)}" class="table-responsive">
+                    <table class="table align-middle mb-0 matrix26-table">
+                        <thead><tr><th>Schedule</th><th>Instance</th><th>Frequency</th><th>Next run</th><th>Last status</th><th>State</th><th></th></tr></thead>
+                        <tbody>
