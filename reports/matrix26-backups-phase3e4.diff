+<!DOCTYPE html>
+<html lang="en" xmlns:th="http://www.thymeleaf.org">
+<head th:replace="~{control_center/fragments/head :: head('Backup alerts')}"></head>
+<body class="matrix26-body">
+<div class="matrix26-shell">
+    <aside th:replace="~{control_center/fragments/sidebar :: sidebar(${activePage})}"></aside>
+    <div class="matrix26-content">
+        <header th:replace="~{control_center/fragments/topbar :: topbar('Backup alerts', 'Operational conditions that require administrator attention.')}"></header>
+        <main class="matrix26-main">
+            <div th:if="${backupSuccess}" class="alert alert-success" th:text="${backupSuccess}"></div>
+            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
+                <div><span class="matrix26-eyebrow">Monitoring</span><h1 class="matrix26-page-title" th:text="${all ? 'All backup alerts' : 'Open backup alerts'}">Alerts</h1></div>
+                <div class="d-flex gap-2">
+                    <a class="btn btn-outline-secondary" th:href="@{/control-center/backups/schedules}"><i class="bi bi-arrow-left me-1"></i>Schedules</a>
+                    <a class="btn btn-outline-primary" th:href="${all} ? @{/control-center/backups/alerts} : @{/control-center/backups/alerts(all=true)}" th:text="${all ? 'Open only' : 'Show all'}">Filter</a>
+                </div>
+            </div>
+            <section class="matrix26-panel">
+                <div th:if="${#lists.isEmpty(alerts)}" class="matrix26-empty-state">
+                    <i class="bi bi-shield-check"></i><strong>No backup alerts</strong><span>Scheduled backup prerequisites and recent recovery points are healthy.</span>
+                </div>
+                <div th:unless="${#lists.isEmpty(alerts)}" class="matrix26-backup-alert-list">
+                    <article th:each="alert : ${alerts}" class="matrix26-backup-alert-item">
+                        <span class="matrix26-backup-alert-icon"><i class="bi bi-bell-fill"></i></span>
+                        <div class="flex-grow-1">
+                            <div class="d-flex gap-2 align-items-center flex-wrap mb-1">
+                                <strong th:text="${alert.title}">Alert</strong>
+                                <span class="badge" th:classappend="${alert.severity.badgeClass}" th:text="${alert.severity.label}">Severity</span>
+                                <span class="badge" th:classappend="${alert.status.name() == 'OPEN' ? ' text-bg-danger' : ' text-bg-success'}" th:text="${alert.status}">OPEN</span>
+                            </div>
+                            <p class="mb-1" th:text="${alert.message}">Message</p>
+                            <small><code th:text="${alert.alertCode}">CODE</code> · <span th:text="${alert.instanceCode}">instance</span> · <span th:text="${#temporals.format(alert.createdAt, 'dd/MM/yyyy HH:mm:ss')}">date</span></small>
+                        </div>
+                        <form th:if="${alert.status.name() == 'OPEN'}" method="post" th:action="@{/control-center/backups/alerts/{id}/resolve(id=${alert.id})}">
+                            <button class="btn btn-sm btn-outline-success" type="submit" title="Resolve alert"><i class="bi bi-check2"></i></button>
+                        </form>
+                    </article>
+                </div>
+            </section>
+        </main>
+    </div>
+</div>
+<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
+</body>
+</html>
