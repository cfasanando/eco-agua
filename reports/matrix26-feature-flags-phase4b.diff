+
+fail() {
+  echo "[FAIL] $1" >&2
+  exit 1
+}
+
+require_file() {
+  [[ -f "$1" ]] || fail "Missing file: $1"
+}
+
+require_grep() {
+  local pattern="$1"
+  local file="$2"
+  grep -qE "$pattern" "$file" || fail "Pattern not found in $file: $pattern"
+}
+
+require_file "src/main/java/com/ecoamazonas/eco_agua/config/SystemModuleVisibilityMapper.java"
