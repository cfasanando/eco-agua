+                                           placeholder="Operational reason for reactivation">
+                                    <input class="form-control form-control-sm mb-2" name="confirmation" required
+                                           th:placeholder="${view.reactivateConfirmation()}">
+                                    <button class="btn btn-sm btn-outline-success" type="submit">
+                                        <i class="bi bi-play-circle me-1"></i>Reactivate laboratory
+                                    </button>
+                                </form>
+                                <span th:if="${!view.canSuspend() && !view.canReactivate()}" class="text-muted small">No lifecycle action available</span>
+                            </td>
+                        </tr>
+                        </tbody>
+                    </table>
+                </div>
+            </section>
+
+            <section class="matrix26-panel">
+                <div class="matrix26-panel-header">
+                    <div><h2>Recent lifecycle jobs</h2><p>Every transition keeps a permanent event trail.</p></div>
+                </div>
+                <div class="table-responsive">
+                    <table class="table align-middle mb-0 matrix26-table">
+                        <thead><tr><th>Job</th><th>Instance</th><th>Action</th><th>Status</th><th>Requested</th><th>Reason</th><th></th></tr></thead>
+                        <tbody>
