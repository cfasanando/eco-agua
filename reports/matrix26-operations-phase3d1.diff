+        <header th:replace="~{control_center/fragments/topbar :: topbar('Logs', 'Safe inventory of diagnostic files associated with each runtime.')}" ></header>
+        <main class="matrix26-main">
+            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4">
+                <div class="matrix26-inline-summary"><span><strong th:text="${#lists.size(logs)}">0</strong> associated files</span><span>Sensitive values are masked when displayed</span></div>
