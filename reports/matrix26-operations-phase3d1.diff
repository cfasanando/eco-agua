+                            <td><span class="badge" th:classappend="${log.currentCandidate() ? ' text-bg-info' : ' text-bg-light border text-dark'}" th:text="${log.currentCandidate() ? 'Primary' : 'Related'}">Priority</span></td>
+                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" th:href="@{/control-center/operations/runtimes/{key}(key=${log.runtimeKey()})}"><i class="bi bi-eye"></i></a></td>
+                        </tr>
+                        <tr th:if="${#lists.isEmpty(logs)}"><td colspan="6" class="text-center text-muted py-5">No associated logs were found. Runtimes started in a terminal may not redirect their output to a file.</td></tr>
