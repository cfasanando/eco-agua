+    gap: 1rem;
+}
+
+.matrix26-operations-summary article {
+    display: flex;
+    align-items: center;
+    gap: .85rem;
+    min-width: 0;
+    padding: 1rem;
+    border: 1px solid var(--matrix26-border, #dce3ee);
