+                            </td>
+                            <td>
+                                <span class="badge" th:classappend="${runtime.configurationPresent() && runtime.configurationConsistent() ? ' text-bg-success' : ' text-bg-warning'}" th:text="${runtime.configurationPresent() ? (runtime.configurationConsistent() ? 'Consistent' : 'Review') : 'Missing'}">Configuration</span>
