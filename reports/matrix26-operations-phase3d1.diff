+    background: var(--matrix26-surface, #ffffff);
+    box-shadow: 0 12px 28px rgba(15, 23, 42, .05);
+}
+
+.matrix26-operations-summary article > div {
+    display: grid;
+    min-width: 0;
+}
+
+.matrix26-operations-summary strong {
+    color: var(--matrix26-heading, #172033);
+    font-size: 1.35rem;
+    line-height: 1.15;
+}
+
+.matrix26-operations-summary small {
+    overflow: hidden;
+    color: var(--matrix26-muted, #667085);
+    font-size: .76rem;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.matrix26-operation-icon {
+    display: inline-grid;
+    width: 42px;
+    height: 42px;
+    flex: 0 0 42px;
+    place-items: center;
+    border-radius: 13px;
+    font-size: 1.05rem;
+}
+
+.matrix26-operation-icon.is-primary { color: #1d4ed8; background: #dbeafe; }
+.matrix26-operation-icon.is-success { color: #047857; background: #d1fae5; }
+.matrix26-operation-icon.is-warning { color: #a16207; background: #fef3c7; }
+.matrix26-operation-icon.is-secondary { color: #475569; background: #e2e8f0; }
+.matrix26-operation-icon.is-info { color: #0e7490; background: #cffafe; }
+.matrix26-operation-icon.is-dark { color: #334155; background: #e2e8f0; }
+
+.matrix26-runtime-table td {
+    vertical-align: middle;
+}
+
+.matrix26-runtime-table td small,
+.matrix26-runtime-table td code {
+    display: block;
+    max-width: 270px;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.matrix26-runtime-state-card {
+    display: flex;
+    align-items: flex-start;
+    gap: 1rem;
+    padding: 1rem;
