+<!DOCTYPE html>
+<html lang="en" xmlns:th="http://www.thymeleaf.org">
+<head th:replace="~{control_center/fragments/head :: head('Archive destruction detail')}"></head>
+<body class="matrix26-body">
+<div class="matrix26-shell">
+    <aside th:replace="~{control_center/fragments/sidebar :: sidebar(${activePage})}"></aside>
+    <div class="matrix26-content">
+        <header th:replace="~{control_center/fragments/topbar :: topbar('Archive destruction detail', 'Read-only evidence for final archive package governance.')} "></header>
+        <main class="matrix26-main">
+            <div th:if="${purgeSuccess}" class="alert alert-success" th:text="${purgeSuccess}"></div>
+            <div th:if="${purgeError}" class="alert alert-danger" th:text="${purgeError}"></div>
+
+            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
+                <div>
+                    <h1 class="h4 mb-1" th:text="${plan.publicId()}">ADS</h1>
+                    <p class="text-muted mb-0" th:text="|${plan.instanceName()} · ${plan.instanceCode()}|">Instance</p>
+                </div>
+                <div class="d-flex gap-2 flex-wrap">
+                    <span class="badge fs-6"
+                          th:classappend="${plan.status().name() == 'READY_FOR_REVIEW' ? ' text-bg-success' : (plan.status().name() == 'BLOCKED' ? ' text-bg-warning' : (plan.status().name() == 'FAILED' ? ' text-bg-danger' : ' text-bg-secondary'))}"
+                          th:text="${plan.status()}">status</span>
+                    <a class="btn btn-outline-secondary" th:href="@{/control-center/purge/archive-destruction}"><i class="bi bi-arrow-left me-1"></i>Archive destruction</a>
+                    <a class="btn btn-outline-primary" th:href="@{/control-center/purge/archive-destruction/{id}/report(id=${plan.id()})}"><i class="bi bi-download me-1"></i>Report</a>
+                    <form method="post" th:if="${plan.status().name() == 'READY_FOR_REVIEW' || plan.status().name() == 'BLOCKED' || plan.status().name() == 'FAILED'}" th:action="@{/control-center/purge/archive-destruction/{id}/refresh(id=${plan.id()})}">
+                        <button class="btn btn-primary" type="submit"><i class="bi bi-arrow-clockwise me-1"></i>Refresh planner</button>
+                    </form>
+                </div>
+            </div>
+
+            <div class="matrix26-alert-safe mb-4">
+                <i class="bi bi-shield-lock"></i>
+                <div>
+                    <strong>Phase 3H.3 is read-only</strong>
+                    <p>Even when resources are marked WOULD_DELETE, this screen only means “candidate for a future phase”. It does not remove files or database records.</p>
+                </div>
+            </div>
+
+            <section class="row g-3 mb-4">
+                <div class="col-xl-6">
+                    <div class="matrix26-panel h-100">
+                        <div class="matrix26-panel-header"><div><h2>Archive metadata</h2><p>Final archive references and retention data.</p></div></div>
+                        <dl class="row mb-0 matrix26-definition-list">
+                            <dt class="col-sm-4">Archive</dt><dd class="col-sm-8"><code th:text="${plan.archivePublicId()}">ARC</code></dd>
+                            <dt class="col-sm-4">Final backup</dt><dd class="col-sm-8"><code th:text="${plan.finalBackupPublicId()}">BKP</code></dd>
+                            <dt class="col-sm-4">Package</dt><dd class="col-sm-8"><code th:text="${plan.packagePath() != null ? plan.packagePath() : '—'}">package</code></dd>
+                            <dt class="col-sm-4">Directory</dt><dd class="col-sm-8"><code th:text="${plan.backupDirectory() != null ? plan.backupDirectory() : '—'}">dir</code></dd>
+                            <dt class="col-sm-4">Retention</dt><dd class="col-sm-8" th:text="|${plan.retentionStatus()} · ${plan.retentionUntil() != null ? #temporals.format(plan.retentionUntil(), 'yyyy-MM-dd HH:mm:ss') : 'No date'}|">retention</dd>
+                            <dt class="col-sm-4">Last error</dt><dd class="col-sm-8 text-danger" th:text="${plan.lastError() != null ? plan.lastError() : '—'}">—</dd>
+                        </dl>
+                    </div>
+                </div>
+                <div class="col-xl-6">
+                    <div class="matrix26-panel h-100">
+                        <div class="matrix26-panel-header"><div><h2>Safety checks</h2><p>Any blocker prevents future package destruction.</p></div></div>
+                        <div class="table-responsive">
+                            <table class="table align-middle mb-0 matrix26-table">
+                                <thead><tr><th>Check</th><th>Status</th><th>Detail</th></tr></thead>
+                                <tbody>
+                                <tr th:if="${#lists.isEmpty(checks)}"><td colspan="3" class="text-center text-muted py-4">No checks recorded.</td></tr>
+                                <tr th:each="check : ${checks}">
+                                    <td><strong th:text="${check.label()}">check</strong><small class="d-block text-muted" th:text="${check.checkCode()}">code</small></td>
+                                    <td><span class="badge" th:classappend="${check.status() == 'PASSED' ? ' text-bg-success' : ' text-bg-danger'}" th:text="${check.status()}">status</span></td>
+                                    <td th:text="${check.detail()}">detail</td>
+                                </tr>
+                                </tbody>
+                            </table>
+                        </div>
+                    </div>
+                </div>
+            </section>
+
+            <section class="matrix26-panel mb-4">
+                <div class="matrix26-panel-header"><div><h2>Archive package classification</h2><p>WOULD_DELETE is only a future candidate marker in this phase.</p></div></div>
+                <div class="table-responsive">
+                    <table class="table align-middle mb-0 matrix26-table">
+                        <thead><tr><th>Disposition</th><th>Resource</th><th>Path / reference</th><th>Size</th><th>Files</th><th>Detail</th></tr></thead>
+                        <tbody>
+                        <tr th:if="${#lists.isEmpty(items)}"><td colspan="6" class="text-center text-muted py-4">No items recorded.</td></tr>
+                        <tr th:each="item : ${items}">
+                            <td><span class="badge" th:classappend="${item.disposition().name() == 'WOULD_DELETE' ? ' text-bg-warning' : (item.disposition().name() == 'PROTECTED' ? ' text-bg-success' : (item.disposition().name() == 'BLOCKED' ? ' text-bg-danger' : ' text-bg-secondary'))}" th:text="${item.disposition()}">status</span></td>
+                            <td><strong th:text="${item.resourceType()}">type</strong><small class="d-block text-muted" th:text="${item.resourceName()}">name</small></td>
+                            <td><code th:text="${item.resourcePath()}">path</code></td>
+                            <td th:text="${item.sizeLabel()}">size</td>
+                            <td th:text="${item.fileCount() != null ? item.fileCount() : '—'}">files</td>
+                            <td th:text="${item.detail()}">detail</td>
+                        </tr>
+                        </tbody>
+                    </table>
+                </div>
+            </section>
+
+            <section class="matrix26-panel">
+                <div class="matrix26-panel-header"><div><h2>Audit timeline</h2><p>Planner events only.</p></div></div>
+                <div class="table-responsive">
+                    <table class="table align-middle mb-0 matrix26-table">
+                        <thead><tr><th>Time</th><th>Event</th><th>Status</th><th>Actor</th><th>Detail</th></tr></thead>
+                        <tbody>
+                        <tr th:if="${#lists.isEmpty(events)}"><td colspan="5" class="text-center text-muted py-4">No events recorded.</td></tr>
+                        <tr th:each="event : ${events}">
+                            <td th:text="${#temporals.format(event.createdAt(), 'yyyy-MM-dd HH:mm:ss')}">time</td>
+                            <td th:text="${event.eventType()}">event</td>
+                            <td><span class="badge" th:classappend="${event.status() == 'COMPLETED' || event.status() == 'READY_FOR_REVIEW' ? ' text-bg-success' : (event.status() == 'FAILED' || event.status() == 'BLOCKED' ? ' text-bg-danger' : ' text-bg-secondary')}" th:text="${event.status()}">status</span></td>
+                            <td th:text="${event.actor()}">actor</td>
+                            <td th:text="${event.detail()}">detail</td>
+                        </tr>
+                        </tbody>
+                    </table>
+                </div>
+            </section>
+        </main>
+    </div>
+</div>
+</body>
+</html>
