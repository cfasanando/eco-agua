+<!DOCTYPE html>
+<html lang="en" xmlns:th="http://www.thymeleaf.org">
+<head th:replace="~{control_center/fragments/head :: head('Archive destruction planner')}"></head>
+<body class="matrix26-body">
+<div class="matrix26-shell">
+    <aside th:replace="~{control_center/fragments/sidebar :: sidebar(${activePage})}"></aside>
+    <div class="matrix26-content">
+        <header th:replace="~{control_center/fragments/topbar :: topbar('Archive Destruction Planner', 'Phase 3H.3 reviews final archive destruction candidates without removing files.')}"></header>
+        <main class="matrix26-main">
+            <div th:if="${purgeSuccess}" class="alert alert-success" th:text="${purgeSuccess}"></div>
