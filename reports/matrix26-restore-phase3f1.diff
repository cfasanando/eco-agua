+                <div class="col-12 col-xl-5"><section class="matrix26-panel h-100"><div class="matrix26-panel-header"><div><span>Artifacts</span><h2>Recovery references</h2></div></div><div th:each="item : ${artifacts}" class="matrix26-runtime-file"><div><strong th:text="${item.artifactType}">Type</strong><small><code class="matrix26-code-wrap" th:text="${item.path}">path</code></small></div><span class="badge text-bg-success" th:text="${item.status}">VERIFIED</span></div><p th:if="${#lists.isEmpty(artifacts)}" class="text-muted mb-0">No artifacts registered.</p></section></div>
+            </div>
+        </main>
+    </div>
+</div>
+</body>
+</html>
