+                        <div><div class="d-flex align-items-center gap-2 flex-wrap"><strong th:text="${step.label}">Step</strong><span class="badge" th:classappend="${step.status.badgeClass}" th:text="${step.status.label}">Status</span></div><small th:if="${step.detail}" th:text="${step.detail}">Detail</small><small th:if="${step.startedAt}" th:text="|Started ${#temporals.format(step.startedAt, 'dd/MM/yyyy HH:mm:ss')}|">time</small></div>
+                    </article>
+                </div>
+            </section>
+
+            <div class="row g-4">
