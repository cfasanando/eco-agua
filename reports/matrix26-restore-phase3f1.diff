+        <header th:replace="~{control_center/fragments/topbar :: topbar('Restore job', 'Complete recovery trace for the isolated clone.')}" ></header>
+        <main class="matrix26-main">
+            <div th:if="${restoreSuccess}" class="alert alert-success" th:text="${restoreSuccess}"></div>
+            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
+                <div><span class="matrix26-eyebrow" th:text="${job.publicId}">RST</span><h1 class="matrix26-page-title" th:text="${job.targetInstanceName}">Restore test</h1><p class="matrix26-page-subtitle mb-0"><code th:text="${job.backupPublicId}">BKP</code> → <code th:text="${job.targetInstanceCode}">clone</code></p></div>
+                <div class="d-flex gap-2"><span class="badge fs-6" th:classappend="${job.status.badgeClass}" th:text="${job.status.label}">Status</span><a class="btn btn-outline-secondary" th:href="@{/control-center/restores}"><i class="bi bi-arrow-left me-1"></i>Back</a></div>
+            </div>
+
+            <div th:if="${job.lastError}" class="alert alert-danger"><strong>Last error:</strong> <span th:text="${job.lastError}">Error</span></div>
+
+            <div class="row g-4 mb-4">
+                <div class="col-12 col-xl-6"><section class="matrix26-panel h-100"><div class="matrix26-panel-header"><div><span>Source</span><h2>Encrypted recovery package</h2></div></div><dl class="matrix26-settings-list"><div><dt>Backup</dt><dd><code th:text="${job.backupPublicId}">BKP</code></dd></div><div><dt>Instance</dt><dd th:text="${job.sourceInstanceName}">Source</dd></div><div><dt>Code</dt><dd><code th:text="${job.sourceInstanceCode}">source</code></dd></div><div><dt>Database</dt><dd><code th:text="${job.sourceDatabaseName}">db</code></dd></div></dl></section></div>
+                <div class="col-12 col-xl-6"><section class="matrix26-panel h-100"><div class="matrix26-panel-header"><div><span>Target</span><h2>Isolated clone</h2></div></div><dl class="matrix26-settings-list"><div><dt>Instance</dt><dd th:text="${job.targetInstanceName}">Clone</dd></div><div><dt>Code</dt><dd><code th:text="${job.targetInstanceCode}">target</code></dd></div><div><dt>Database</dt><dd><code th:text="${job.targetDatabaseName}">db</code></dd></div><div><dt>Runtime / port</dt><dd><code th:text="${job.targetRuntimeProfile}">runtime</code> · <span th:text="${job.targetRuntimePort}">8095</span></dd></div><div><dt>URL</dt><dd><a th:if="${job.completed}" th:href="${job.targetPublicUrl}" target="_blank" rel="noopener" th:text="${job.targetPublicUrl}">URL</a><code th:unless="${job.completed}" th:text="${job.targetPublicUrl}">URL</code></dd></div></dl></section></div>
+            </div>
